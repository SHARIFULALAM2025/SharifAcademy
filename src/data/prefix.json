{
  "topic": {
    "title_bn": "উপসর্গ",
    "title_en": "Prefix",
    "definition": "বাংলা ব্যাকরণে কতগুলো অব্যয়বাচক শব্দাংশ আছে যার নিজস্ব কোন অর্থ নেই কিন্তু অন্য শব্দের পূর্বে বসে সেই শব্দটিকে নতুন শব্দে পরিণত করে, এগুলোকেই উপসর্গ বলে।",
    "characteristics": "উপসর্গের অর্থবাচকতা (নিজস্ব অর্থ) নেই কিন্তু অর্থদ্যোতকতা (অন্য শব্দের অর্থ বদলানোর ক্ষমতা) আছে।"
  },
  "functions_of_prefix": [
    "নতুন শব্দ গঠন করে।",
    "শব্দের অর্থের পরিবর্তন ঘটায়।",
    "অর্থের বিশিষ্টতা দান করে।",
    "অর্থের সঙ্কোচন ঘটায়।",
    "অর্থের সম্প্রসারণ ঘটায়।"
  ],
